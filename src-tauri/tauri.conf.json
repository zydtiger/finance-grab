{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Grab",
  "version": "0.1.0",
  "identifier": "top.ohzyd.finance-grab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./build.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Finance Grab",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "category": "Productivity",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icons.png"
    ],
    "resources": {
      "../finance-api/": "finance-api/"
    }
  }
}
